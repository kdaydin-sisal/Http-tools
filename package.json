{
  "name": "http-tools-mac-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Mac-first HTTP(S) interception and modification toolkit for iOS/Android traffic",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "android:onboard": "node --enable-source-maps dist/bin/android-onboard.js",
    "ios:onboard": "node --enable-source-maps dist/bin/ios-onboard.js",
    "validate:smoke": "node --enable-source-maps dist/bin/smoke-validate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mockttp": "^3.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
